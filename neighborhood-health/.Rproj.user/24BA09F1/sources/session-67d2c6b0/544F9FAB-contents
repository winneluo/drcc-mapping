  na.color = "#cccccc"
)

m <- leaflet(map_data) |>
  addTiles() |>
  
  # Asthma layer
  addPolygons(
    group = "Asthma",
    fillColor = ~pal_asthma(children_asthma_hosp_rateper100k),
    fillOpacity = 0.75,
    color = "white",
    weight = 1,
    popup = ~paste0(
      "<b>ZIP:</b> ", ZCTA5CE20,
      "<br><b>Asthma hospitalization rate in children:</b> ",
      round(children_asthma_hosp_rateper100k, 1),
      " per 100,000 people"
    )
  ) |>
  
  # Life expectancy layer
  addPolygons(
    group = "Life Expectancy",
    fillColor = ~pal_life(life_expect_est),
    fillOpacity = 0.75,
    color = "white",
    weight = 1,
    popup = ~paste0(
      "<b>ZIP:</b> ", ZCTA5CE20,
      "<br><b>Life expectancy:</b> ",
      round(life_expect_est, 1),
      " years"
    )
  ) |>
  
  # Legends with distinct IDs
  addLegend(
    position = "bottomright",
    pal = pal_asthma,
    values = ~children_asthma_hosp_rateper100k,
    title = "Asthma hospitalizations<br>per 100,000",
    layerId = "legend_asthma"
  ) |>
  
  addLegend(
    position = "bottomright",
    pal = pal_life,
    values = ~life_expect_est,
    title = "Life expectancy (years)",
    layerId = "legend_life"
  ) |>
  
  # Layer selector
  addLayersControl(
    baseGroups = c("Asthma", "Life Expectancy"),
    options = layersControlOptions(collapsed = FALSE)
  ) |>
  
  # Reliably toggle the legends
  onRender("
    function(el, x) {
      var map = this;

      function toggleLegends(active) {
        var controls = el.querySelectorAll('.leaflet-control');

        controls.forEach(function(control) {
          var asthma = control.querySelector('#legend_asthma');
          var life = control.querySelector('#legend_life');

          if (asthma) {
            control.style.display =
              active === 'Asthma' ? '' : 'none';
          }

          if (life) {
            control.style.display =
              active === 'Life Expectancy' ? '' : 'none';
          }
        });
      }

      toggleLegends('Asthma');

      map.on('baselayerchange', function(e) {
        toggleLegends(e.name);
      });
    }
  ")

